{
  "name": "@ghost-run/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Ghost Run+ screen kit: mirror world, candle, blacklight, red thread, graveyard, lights on",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "test": "vitest run --project model --project static --project dom --project scan",
    "test:nightly": "GHOST_PBT_MODE=nightly vitest run --project model --project static --project dom --project scan",
    "test:dist": "vitest run --project dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "license": "MIT",
  "dependencies": {
    "@ghost-run/core": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.30.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  }
}
