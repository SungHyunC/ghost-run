{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "paths": { "@ghost-run/core": ["../core/src/index.ts"] }
  },
  "include": [
    "src",
    "gallery",
    "tests/model",
    "tests/static",
    "tests/dom",
    "tests/support",
    "tests/fixtures",
    "tests/*.test-d.ts",
    "tests/regressions.test.tsx"
  ]
}
