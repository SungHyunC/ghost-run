{
  "name": "ghost-run",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "\"$npm_execpath\" -r build",
    "test": "\"$npm_execpath\" -r --workspace-concurrency=1 --no-bail test",
    "typecheck": "\"$npm_execpath\" -r --workspace-concurrency=1 --no-bail typecheck",
    "lint": "\"$npm_execpath\" -r --workspace-concurrency=1 --no-bail lint"
  }
}
