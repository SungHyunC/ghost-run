# Dependencies and build output
node_modules/
dist/
site/build/
.DS_Store

# Secrets (create even fake canary values outside the repository)
.env
.env.*

# Internal plan: not published in the public repository (Kiro can still read it locally)
docs/plan.md
docs/GhostRun_*.png

# Claude Code settings are not committed. Never ignore .kiro/ (required for the submission)
.claude/
CLAUDE.md

# ghost-runner build output and temporary run data
ghost-runner/dist
.ghost-run-*/
ghost-runner/box/*.local

# Private key material (never commit; the box CA key is generated at runtime)
*.key
*.pem
*.p12
*.pfx
id_rsa*
box/ca/
**/ghost/ca/

# Ghost Hand and drawer-arm build output
apps/ghost-hand/dist
apps/ghost-hand/dist-node
worlds/drawer-arm/dist

# Ghost Run runtime data and local MCP config
.ghost-run/
integrations/power/mcp.local.json
