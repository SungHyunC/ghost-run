{
  "name": "@ghost-run/ghost-hand",
  "version": "0.0.0",
  "private": true,
  "description": "Ghost Hand: browser MuJoCo robot arm rehearsal across haunted variants",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/gen-notices.mjs",
    "notices": "node scripts/gen-notices.mjs",
    "build:node": "tsc --noEmit && vite build -c vite.node.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:dist": "npm run build && npm run notices && GHOST_DIST_TESTS=1 vitest run --project dist",
    "test:nightly": "GHOST_PBT_MODE=nightly vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint .",
    "clean": "node -e \"const fs=require('node:fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('dist-node',{recursive:true,force:true})\""
  },
  "license": "MIT",
  "dependencies": {
    "@ghost-run/core": "workspace:*",
    "@ghost-run/drawer-arm": "workspace:*",
    "@ghost-run/ui": "workspace:*",
    "@ghost-run/wards-config": "workspace:*",
    "@mujoco/mujoco": "4.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "0.187.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "bin": {
    "ghost-hand-run": "./dist-node/cli.js"
  }
}
