{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": { "@ghost-run/ui": ["../../ui/src/types.ts"] },
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["bin/**/*.mjs", "src/**/*.mjs", "scripts/**/*.mjs", "tests/**/*.mjs", "vitest.config.ts"],
  "exclude": ["node_modules"]
}
